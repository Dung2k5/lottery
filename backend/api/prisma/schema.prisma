generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id        String   @id @default(uuid())
  code      String   @unique
  slug      String   @unique
  name      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotteryTypes LotteryType[]
  stations     Station[]
}

model Province {
  id        String   @id @default(uuid())
  code      String   @unique
  slug      String   @unique
  name      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotteryTypes LotteryType[]
  stations     Station[]
  externalMappings ExternalProvinceMap[]
}

model Station {
  id        String   @id @default(uuid())
  code      String   @unique
  slug      String   @unique
  name      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id])

  provinceId String?
  province   Province? @relation(fields: [provinceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotteryTypes LotteryType[]
  externalMappings ExternalStationMap[]
}

model DrawMode {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotteryTypes LotteryType[]
}

model DataSource {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  url         String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lotteryTypeMappings ExternalLotteryTypeMap[]
  stationMappings     ExternalStationMap[]
  provinceMappings    ExternalProvinceMap[]
}

model LotteryType {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  category    String   // e.g. MIEN_BAC, MIEN_TRUNG, MIEN_NAM, DIEN_TOAN
  description String?
  isActive    Boolean  @default(true)
  
  regionId    String?
  region      Region?  @relation(fields: [regionId], references: [id])
  
  provinceId  String?
  province    Province? @relation(fields: [provinceId], references: [id])
  
  stationId   String?
  station     Station?  @relation(fields: [stationId], references: [id])
  
  drawModeId  String?
  drawMode    DrawMode? @relation(fields: [drawModeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prizeStructures PrizeStructure[]
  auditLogs       AuditLog[]
  externalMappings ExternalLotteryTypeMap[]
}

model ExternalLotteryTypeMap {
  id              String      @id @default(uuid())
  dataSourceId    String
  dataSource      DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  
  externalCode    String
  externalName    String?
  
  lotteryTypeId   String
  lotteryType     LotteryType @relation(fields: [lotteryTypeId], references: [id], onDelete: Cascade)

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([dataSourceId, externalCode])
}

model ExternalStationMap {
  id              String      @id @default(uuid())
  dataSourceId    String
  dataSource      DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  
  externalCode    String
  externalName    String?
  
  stationId       String
  station         Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([dataSourceId, externalCode])
}

model ExternalProvinceMap {
  id              String      @id @default(uuid())
  dataSourceId    String
  dataSource      DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  
  externalCode    String
  externalName    String?
  
  provinceId      String
  province        Province    @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([dataSourceId, externalCode])
}

model PrizeStructure {
  id            String      @id @default(uuid())
  lotteryTypeId String
  lotteryType   LotteryType @relation(fields: [lotteryTypeId], references: [id], onDelete: Cascade)
  
  code          String
  name          String
  order         Int
  quantity      Int
  digitCount    Int?
  prizeValue    String?
  matchingRule  String?
  
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AuditLog {
  id            String      @id @default(uuid())
  entityType    String      // e.g. "LotteryType", "PrizeStructure"
  entityId      String
  action        String      // CREATE, UPDATE, DELETE, TOGGLE
  beforeState   Json?
  afterState    Json?
  userId        String?
  reason        String?
  createdAt     DateTime    @default(now())

  lotteryType   LotteryType? @relation(fields: [entityId], references: [id], map: "AuditLog_lotteryType_fkey")
}
